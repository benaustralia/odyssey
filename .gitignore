# Artwork is hosted on Cloudinary (folder 'odyssey'); kept locally for re-sync
public/art/

# Card-grid cover thumbnails (generated by scripts/make_thumbs.py) are
# COMMITTED (17MB) and served same-origin by Vercel's CDN — r2.dev is a
# rate-limited, never-cached, HTTP/1.1 dev endpoint (Plan.md chase-100
# session #2), and same-origin HTTP/2 also lets Chrome prioritise hero.jpg
# above the lazy thumbs.

# Pronunciation audio clips are hosted on R2; kept locally for re-sync
public/audio/


# Playwright MCP debug artifacts (screenshots/snapshots/console logs)
.playwright-mcp/

# Atlas plate masters + generated tile pyramids (hosted on Cloudinary)
# Anchored to repo root only -- unanchored "plates/" also matched
# src/data/plates/ (the plate config registry, real source code) and
# silently hid it from git entirely.
/plates/
