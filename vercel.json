{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "odysseygloss.vercel.app" }],
      "destination": "https://tellmeohmuse.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "odysseygloss.vercel.app" }],
      "destination": "https://tellmeohmuse.com/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "(www\\.)?singomuse\\.com" }],
      "destination": "https://tellmeohmuse.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "(www\\.)?singomuse\\.com" }],
      "destination": "https://tellmeohmuse.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/entry/:slug", "destination": "/entry/:slug/index.html" }
  ],
  "headers": [
    {
      "source": "/art-thumb/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
