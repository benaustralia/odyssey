{
  "rewrites": [
    { "source": "/entry/:slug", "destination": "/entry/:slug/index.html" }
  ],
  "headers": [
    {
      "source": "/art-thumb/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
